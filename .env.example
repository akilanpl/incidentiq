# ---- Recurrence app ----------------------------------------------------------
# Hindsight Cloud:  HINDSIGHT_API_URL=https://api.hindsight.vectorize.io  (+ HINDSIGHT_API_KEY)
# Self-host:        HINDSIGHT_API_URL=https://api.hindsight.vectorize.io                 (key usually empty)
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentiq-sre

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=

# 1 = FakeMemory + template answers (no keys, no network). Plumbing only.
RECURRENCE_OFFLINE=0

# ---- Self-hosted Hindsight server (read by docker-compose.yml) ---------------
# Hindsight's own LLM, used for fact extraction and reflect. Groq works here too.
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=        # usually the same Groq key as above
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b

# Local single-operator authentication; setup helper writes .env.auth, never overwrites .env
INCIDENTIQ_AUTH_ENABLED=1
INCIDENTIQ_USERNAME=
INCIDENTIQ_PASSWORD_SALT=
INCIDENTIQ_PASSWORD_HASH=
INCIDENTIQ_SESSION_SECRET=

# Optional read-only recovery verification; supply actual environment-specific PromQL.
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_SERVICE_UP_QUERY=
PROMETHEUS_ERROR_RATE_QUERY=
PROMETHEUS_ERROR_RATE_MAX=
PROMETHEUS_DB_POOL_QUERY=
PROMETHEUS_DB_POOL_MAX=
